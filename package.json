{
  "name": "@microbit-foundation/action-pr-url-template",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub action to comment on a PR with an templated URL",
  "main": "lib/main.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.18.0"
  },
  "allowScripts": {
    "fsevents": true
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "pack": "ncc build lib/main.js -o dist",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run pack && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microbit-foundation/action-pr-url-template.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Matt Hillsdon <matt.hillsdon@microbit.org>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.2.6",
    "@actions/github": "^6.0.0",
    "uri-template": "^1.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "js-yaml": "^3.14.0",
    "prettier": "^1.19.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
